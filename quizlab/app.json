{
  "expo": {
    "name": "quizlab",
    "slug": "quizlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quizlab-icon.png",
    "scheme": "quizlab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/quizlab-icon-monochrome.png",
        "backgroundImage": "./assets/images/quizlab-icon-background.png",
        "monochromeImage": "./assets/images/quizlab-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quizlab-splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
